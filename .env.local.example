# ===== Banco (Postgres / Supabase) — role scoped server-only =====
# App conecta como role `disparos_app` (GRANT só no schema `cs`). NUNCA service_role.
# Pooler Supavisor (IPv4, recomendado p/ Hostinger). Confirmar host em Supabase → Connect.
# Transaction mode (6543) p/ rotas curtas; usar prepare:false no client.
DATABASE_URL=postgresql://disparos_app.<project_ref>:<senha>@aws-1-<region>.pooler.supabase.com:6543/postgres

# ===== Unnichat (WhatsApp) =====
# Fallback global. O caminho normal é cadastrar um canal por evento em /canais —
# aí a credencial vem do banco (cs.canais_disparo) e troca sem deploy.
UNNICHAT_API_KEY=
UNNICHAT_BASE_URL=

# ===== ActiveCampaign (e-mail) =====
# Mesmo raciocínio: o normal é cadastrar o canal em /canais com provider
# `activecampaign`. Estas envs são o fallback.
# No AC: Settings → Developer. A URL é a da SUA conta.
ACTIVECAMPAIGN_API_URL=https://suaconta.api-us1.com
ACTIVECAMPAIGN_API_TOKEN=

# O remetente do e-mail (nome, endereço, frase de lembrete) NÃO é env: vive em
# cs.config e se configura na tela /canais. Sem ele, o disparo por campanha não sai.

# ===== App =====
APP_PASSWORD=          # senha única de acesso (uso interno)
SESSION_SECRET=        # segredo p/ assinar o cookie de sessão (openssl rand -hex 32)
WEBHOOK_SECRET=        # valida origem do webhook de resposta do Unnichat
CRON_SECRET=           # protege /api/cron (header x-cron-secret ou ?secret=)
